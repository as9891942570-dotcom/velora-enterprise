DATABASE_URL=postgresql+asyncpg://velora:velora_dev@localhost:5432/velora
SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_NAME=Velora Enterprise API
DEBUG=true
FRONTEND_URL=http://localhost:3000
SUPPORT_EMAIL=veloraenterprise2@gmail.com
ADMIN_NOTIFICATION_EMAIL=veloraenterprise2@gmail.com

# Resend HTTP email API (use on Render Free — SMTP ports are blocked)
RESEND_API_KEY=
