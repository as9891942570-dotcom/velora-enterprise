PASSWORD_RESET_EXPIRE_MINUTES=60

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Business rules
SHIPPING_FLAT_RATE=99
FREE_SHIPPING_MIN_ORDER=999
LOW_STOCK_THRESHOLD=5

# Set to true to reset admin password on seed (dev only, requires DEBUG=true)
RESET_ADMIN_PASSWORD=false
ADMIN_EMAIL=admin@veloraenterprise.com
ADMIN_PASSWORD=ChangeMe@Admin123!
ADMIN_NAME=Velora Admin

# Razorpay (optional — leave empty for COD-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional — leave empty to skip image uploads)
